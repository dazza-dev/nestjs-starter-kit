# Application
APP_ENV="development"
APP_PORT=3000
APP_URL="http://localhost:3000"
APP_NAME="NestJS Starter"
FRONTEND_URL="http://localhost:5173"
TZ="UTC"

# Database
DB_CONNECTION="mysql"
DATABASE_URL="mysql://root:password@localhost:3306/nestjs_starter"
DATABASE_USER="root"
DATABASE_PASSWORD="password"
DATABASE_NAME="nestjs_starter"
DATABASE_HOST="localhost"
DATABASE_PORT=3306

# Session: the JWT travels signed inside an httpOnly cookie
JWT_SECRET="change-this-secret-for-a-super-secure-one-of-at-least-32-characters"
JWT_EXPIRES_IN="7d"

# Frontend origins
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Email. Points to Mailpit locally (brew install mailpit)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Storage. `local` saves to disk; `s3` requires `pnpm add @aws-sdk/client-s3`
FILESYSTEM_DISK=public
FILESYSTEM_LOCAL_PATH=./storage
FILESYSTEM_PUBLIC_PATH=./storage/public
FILES_BASE_URL=http://localhost:3000/api/v1/files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
S3_URL=

# Redis (required: queues run through it)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Queue panel at /sentinel. If either is empty, the panel won't open.
SENTINEL_USER=ops
SENTINEL_PASSWORD=s3cret-queues
